---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@config";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import LinkCard from "@/components/mdx/LinkCard.astro";
import FriendCard from "@/components/mdx/FriendCard.astro";
---

<BaseLayout title="Friends">
  <MainCard
    title="Friends"
    description="Friends of Wangzc2012."
    textOverlay="FRIENDS"
    infoIcon="lucide:link"
  >
    <div class="space-y-10">
      <!-- Friends Section -->
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:users" class="w-6 h-6 text-primary" />
          <span>Friends</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <FriendCard
            name="tzzl3035"
            avatar="https://cdn.luogu.com.cn/upload/usericon/1030559.png"
            description="全能 dalao"
            url="https://tzzl.site/"
            type="friend"
          />
          <FriendCard
            name="Fish_redflying"
            avatar="https://cdn.luogu.com.cn/upload/usericon/1029122.png"
            description="芋头教授"
            url="https://www.luogu.com.cn/user/1029122"
            type="friend"
          />
          <FriendCard
            name="Kun_is_Me"
            avatar="https://cdn.luogu.com.cn/upload/usericon/973540.png"
            description="dalao *1"
            url="https://www.luogu.com.cn/user/973540"
            type="friend"
          />
          <FriendCard
            name="NC20061226"
            avatar="https://cdn.luogu.com.cn/upload/usericon/973540.png"
            description="奶茶"
            url="https://www.luogu.com.cn/user/965351"
            type="friend"
          />
          <FriendCard
            name="AwuOi"
            avatar="https://cdn.luogu.com.cn/upload/usericon/1213769.png"
            description="awu~"
            url="https://www.luogu.com.cn/user/1213769"
            type="friend"
          />
        </div>
      </section>

      <div class="divider my-8">
        <Icon name="lucide:heart" class="w-10 h-10 text-primary" />
      </div>

      <div class="text-center">
        <p class="text-base-content/80 mb-4">
          Want to be featured on this page? Feel free to reach out or contribute to the project!
        </p>
        <a
          href="https://github.com/wangzc2012/Blog"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary gap-2"
        >
          <Icon name="lucide:github" class="w-5 h-5" />
          <span>Contribute on GitHub</span>
        </a>
      </div>
    </div>
  </MainCard>
</BaseLayout>
